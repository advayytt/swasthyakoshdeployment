# ---------------------------------------------------------------------------
# Swasthya Kosh - copy this file to ".env" and fill in what you have.
# The app runs with NONE of these set. Every one of them is an upgrade,
# not a requirement.
# ---------------------------------------------------------------------------

SECRET_KEY=change-this-to-any-random-string

# Leave true while developing (auto-reload on save).
# Set to false BEFORE A DEMO: a crash then shows a friendly error page
# instead of a Python stack trace in front of judges.
DEBUG=true

# --- Supabase --------------------------------------------------------------
# Supabase dashboard > Connect > Session pooler > copy the URI, then replace
# [YOUR-PASSWORD] with your database password.
# Leave DATABASE_URL blank to run on a local SQLite file instead.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- AI provider -----------------------------------------------------------
# gemini | groq | openrouter | none
AI_PROVIDER=gemini

# https://aistudio.google.com/apikey  (free tier, does text AND vision)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# https://console.groq.com/keys  (free tier, very fast)
# Used for AI_PROVIDER=groq text generation, AND automatically as the
# server-side speech-to-text fallback for English in routes/speech.py /
# services/groq_speech.py whenever Bhashini has no ASR service for the
# spoken language (or BHASHINI_ENABLED is off). No separate flag needed —
# set this key and it is picked up.
#
# Text and vision use DIFFERENT Groq models — Groq's text model is not
# vision-capable and vice versa (see the GROQ_MODEL/GROQ_VISION_MODEL
# comment in config.py). GROQ_VISION_MODEL currently points at a Preview
# model (Groq's only vision option right now); Preview models can be
# discontinued at short notice per Groq's own docs. Groq retires models
# on a rolling schedule (https://console.groq.com/docs/deprecations); if
# either of these 404s, check that page and
# https://console.groq.com/docs/vision for the current names.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# https://openrouter.ai/keys  (free-tier models available)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free

AI_TIMEOUT=45

# --- ABDM ------------------------------------------------------------------
# Keep MOCK_ABDM=true until your sandbox application is approved.
# In mock mode every OTP is 246813.
MOCK_ABDM=true
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=

# --- Bhashini (MeitY National Language Translation Mission) ----------------
# Optional. The kiosk's speech features already work with none of this set —
# the browser's own Web Speech API handles recognition and synthesis with no
# key needed. Fill this in once your Bhashini API request is approved to
# route speech through Bhashini's Indian-language-specific models instead.
# Leave BHASHINI_ENABLED=false (or unset) until then; nothing else in this
# file matters if that flag is off.
BHASHINI_ENABLED=false
BHASHINI_USER_ID=
BHASHINI_API_KEY=
# Leave blank to use Bhashini's standard published ASR+Translation+TTS
# pipeline. Only set this if your account was issued a different one.
BHASHINI_PIPELINE_ID=

CONSENT_DEFAULT_HOURS=24
LOW_CONFIDENCE_THRESHOLD=0.75
